# /etc/paylink/backup.env — PayLink production DB backup configuration.
# Install as: root:mypaylink-app, mode 0640. Contains NO secrets by design:
# the DB password stays in /etc/paylink/.env, the off-server credential stays in
# rclone.conf (0600, paylinkssh), and only a PUBLIC gpg key is on the server.
# Runbook: docs/deployment/production-db-backup.md

PAYLINK_BACKUP_LABEL=prod

# Local encrypted copies (this directory only; pre-deploy dumps are never touched)
PAYLINK_BACKUP_DIR=/var/backups/paylink/nightly
PAYLINK_BACKUP_LOCAL_RETAIN_DAYS=14

# Fingerprint of the OFFLINE-held backup key (public half imported below)
PAYLINK_BACKUP_GPG_RECIPIENT=REPLACE_WITH_40_HEX_FINGERPRINT
PAYLINK_BACKUP_GNUPGHOME=/home/paylinkssh/.paylink-backup-gnupg

# rclone remote:path — a bucket in a different provider/region than this VPS
PAYLINK_BACKUP_RCLONE_REMOTE=paylink-offsite:REPLACE_BUCKET/prod
PAYLINK_BACKUP_RCLONE_CONFIG=/home/paylinkssh/.config/rclone/rclone.conf

# Leave unset to keep remote retention in bucket lifecycle rules (recommended:
# the server credential then needs no delete permission). If set, must be >= 7.
#PAYLINK_BACKUP_REMOTE_RETAIN_DAYS=90

# Restore drill on every run (1 = on). Thresholds for "this looks like PayLink".
PAYLINK_BACKUP_RESTORE_VERIFY=1
PAYLINK_BACKUP_MIN_TABLES=150
PAYLINK_BACKUP_REQUIRE_ROWS=companies users workers

# Dead-man switch: pinged on start, success and /fail. Alerts if no success
# arrives within the configured period (e.g. healthchecks.io, period 1d, grace 2h).
PAYLINK_BACKUP_HEALTHCHECK_URL=
# Failure email (uses SMTP_* from /etc/paylink/.env)
PAYLINK_BACKUP_ALERT_EMAIL=

# Optional least-privilege DB login (role with pg_read_all_data; creating it is a
# production DB change that needs separate approval). When unset, the app's
# DATABASE_URL from /etc/paylink/.env is used. NOTE: setting this puts a password
# in this file — then make it paylinkssh:mypaylink-app mode 0600.
#PAYLINK_BACKUP_DATABASE_URL=
