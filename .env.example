# PayLink Production Environment Configuration
# Copy this file to .env and fill in your values

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=8000

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://lshawver:YOUR_PASSWORD@127.0.0.1:5432/paylink

# ── Session / Auth ──────────────────────────────────────────
SESSION_SECRET=generate_a_long_random_secret_here

# ── Base URLs ────────────────────────────────────────────────
PUBLIC_BASE_URL=https://mypaylink.app
APP_BASE_URL=https://app.mypaylink.app

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=/home/paylinkssh/paylink-app/PayLink/uploads

# ── Email (optional) ────────────────────────────────────────
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── AI Receipt Scanning (optional) ──────────────────────────
OPENAI_API_KEY=

# ── Twilio SMS (optional) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
