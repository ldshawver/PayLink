# PayLink Production Environment Configuration
# Copy this file to .env and fill in your values

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=8000

# ── Database (PostgreSQL) ────────────────────────────────────
# REQUIRED in production. App will refuse to start without it.
DATABASE_URL=postgresql://lshawver:YOUR_PASSWORD@127.0.0.1:5432/paylink

# ── Session / Auth ──────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Base URLs ────────────────────────────────────────────────
# RECOMMENDED. Used for absolute links in emails, SMS, and redirects.
# If not set, the app will derive URLs from request headers (less reliable).
APP_BASE_URL=https://app.mypaylink.app

# ── File Uploads ─────────────────────────────────────────────
# Directory where uploaded files are stored. Must be writable by the app user.
# If not set, defaults to ./uploads relative to the project root.
# On VPS, use an absolute path:
UPLOAD_DIR=/home/paylinkssh/paylink-app/PayLink/uploads
# Expected permissions: directory owned by app user, mode 755 (drwxr-xr-x)
# Files inside: mode 644 (owner read/write, group/other read)

# ── Email (SMTP) — optional ─────────────────────────────────
# Required for schedule notifications, approval reminders, time-off emails
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mypaylink.app

# ── AI Receipt Scanning — optional ──────────────────────────
# Requires an OpenAI API key with GPT-4o Vision access
OPENAI_API_KEY=

# ── Twilio SMS — optional ───────────────────────────────────
# Required for SMS notifications (schedules, time-off, marketplace)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
