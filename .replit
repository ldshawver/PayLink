modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["haskellPackages.concurrent-dns-cache", "rsync"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3001

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]
publicDir = "dist/public"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-json-guard"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "api-json-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/__tests__/api-json-guard.test.ts"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.office365.com"
SMTP_PORT = "587"
SMTP_TLS = "true"
SMTP_USER = "no-reply@mypaylink.app"
SMTP_FROM = "no-reply@mypaylink.app"
SMTP_ENCRYPTION = "STARTTLS"
SMTP_AUTHENTICATION = "Required"

[agent]
integrations = ["stripe:1.0.0"]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
